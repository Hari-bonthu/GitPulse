# GitPulse — AI Commit Message Configuration
# Copy this file to .env and add your API keys

# AI Provider: 'gemini' or 'openai' (gemini is checked first)
AI_PROVIDER=gemini

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenAI API Key (optional fallback, get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=
